#!/usr/bin/env bash
# Runs what CI runs, without fixing anything: each package's bin/ci, the
# starter bin/ script tests and shellcheck. Run it before you push.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=lib/each.sh
source bin/lib/each.sh
status=0
run_each ci || status=1
echo "==> templates"
run_template_tests || status=1
if command -v shellcheck >/dev/null; then
  echo "==> shellcheck"
  find bin templates/common/bin -type f -print0 | xargs -0 shellcheck -x || status=1
else
  echo "==> shellcheck not installed; CI runs it"
fi
exit "$status"
