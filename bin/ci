#!/usr/bin/env bash
# Runs what CI runs, without fixing anything: each package's bin/ci, the
# template tests and shellcheck. Run it before you push.
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/lib/each.sh
status=0
run_each ci || status=1
echo "==> templates"
run_template_tests || status=1
if command -v shellcheck >/dev/null; then
  echo "==> shellcheck"
  shellcheck -x bin/* bin/lib/*.sh templates/shared/bin/* templates/shared/bin/lib/*.sh || status=1
else
  echo "==> shellcheck not installed; CI runs it"
fi
exit "$status"
