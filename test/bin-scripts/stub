#!/usr/bin/env bash
# Stands in for bundle and pnpm: records each command line in $STUB_LOG, lists
# $STUB_RAKE_TASKS for `bundle exec rake -P`, and exits 1 when the command line
# matches one of the newline-separated globs in $STUB_FAIL.
set -euo pipefail

line=$(basename "$0")
if (($#)); then line+=$(printf ' %q' "$@"); fi

if [[ $line == "bundle exec rake -P" ]]; then
  for task in ${STUB_RAKE_TASKS:-}; do echo "rake $task"; done
  exit 0
fi

echo "$line" >>"$STUB_LOG"
while IFS= read -r pattern; do
  # shellcheck disable=SC2053 # -- the pattern is a glob on purpose
  if [[ -n $pattern && $line == $pattern ]]; then exit 1; fi
done <<<"${STUB_FAIL:-}"
